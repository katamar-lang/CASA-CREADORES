# ============================================
# Casa Creadores - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Backend ---
NODE_ENV=development
PORT=4000

# PostgreSQL (Railway te da esta URL directamente)
DATABASE_URL="postgresql://user:password@localhost:5432/casa_creadores?schema=public"

# JWT
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# URL pública del frontend (para links de verificación de email y CORS)
FRONTEND_URL="http://localhost:5173"

# Email (mock por defecto: se imprime en consola del backend).
# Si se configuran estas variables con un proveedor SMTP real, se usan en su lugar.
EMAIL_FROM="Casa Creadores <no-reply@casacreadores.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Pagos USDC (Circle API) - opcional para MVP, pagos funcionan en modo mock sin esto
CIRCLE_API_KEY=""
CIRCLE_API_URL="https://api-sandbox.circle.com"

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:4000/api"
