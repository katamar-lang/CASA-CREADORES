# ============================================
# Casa Creadores - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Backend (Railway) ---
NODE_ENV=development
PORT=4000

# PostgreSQL (Railway te da esta URL directamente).
# OBLIGATORIA: sin ella el backend no arranca y lo dice en el log.
DATABASE_URL="postgresql://user:password@localhost:5432/casa_creadores?schema=public"

# JWT. OBLIGATORIAS y distintas entre sí: el backend se niega a arrancar sin ellas
# en vez de fallar más tarde con un 500 en el primer registro.
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Origen(es) permitidos para CORS y base de los links de verificación de email.
# Acepta varios separados por coma, p.ej.:
#   FRONTEND_URL="https://casa-creadores.vercel.app,https://casacreadores.com"
#
# Ya NO es un punto único de fallo: CORS acepta siempre cualquier *.vercel.app y
# localhost aunque esta variable esté mal o vacía. Sigue siendo necesaria para un
# dominio propio (casacreadores.com) y para los enlaces de verificación por email.
FRONTEND_URL="http://localhost:5173"

# Email.
# IMPORTANTE: mientras SMTP_HOST y SMTP_USER estén vacíos, el backend NO exige
# verificación por email (la cuenta se activa al registrarse). En cuanto se
# configuren, el registro vuelve a requerir confirmación por correo.
EMAIL_FROM="Casa Creadores <no-reply@casacreadores.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Pagos USDC (Circle API) - opcional para MVP, pagos funcionan en modo mock sin esto
CIRCLE_API_KEY=""
CIRCLE_API_URL="https://api-sandbox.circle.com"


# --- Frontend (Vercel) ---

# Se lee en tiempo de ejecución por la función
# `packages/frontend/api/[...path].ts`, que reenvía `/api/*` al backend.
# Como el navegador solo habla con el dominio de Vercel, no hay CORS que romper,
# y cambiarla NO exige reconstruir el frontend.
# Ya tiene un valor por defecto en el código
# (https://casa-creadores-production.up.railway.app), así que solo hace falta
# definirla si la URL del backend cambia.
BACKEND_URL=""

# Opcional y desaconsejada en producción: fuerza al navegador a llamar
# directamente al backend en vez de pasar por el proxy (vuelve a depender de
# CORS). Se congela en el bundle durante el build. En desarrollo local no hace
# falta: sin definirla, la app usa http://localhost:4000/api automáticamente.
VITE_API_URL=""

# Enlaces sociales (opcionales). Los perfiles reales ya están fijados en
# packages/frontend/src/lib/site.ts; estas variables solo sirven para
# sobrescribirlos. Un perfil sin URL no se renderiza, en vez de enlazar a uno
# inexistente.
VITE_SOCIAL_X=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_INSTAGRAM=""

# Email de contacto público (opcional). Si está vacío, el sitio usa únicamente
# el formulario interno de /contacto, sin mostrar ningún mailto.
VITE_CONTACT_EMAIL=""
