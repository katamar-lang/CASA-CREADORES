# ============================================
# Casa Creadores - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================

# --- Backend ---
NODE_ENV=development
PORT=4000

# PostgreSQL (Railway te da esta URL directamente)
DATABASE_URL="postgresql://user:password@localhost:5432/casa_creadores?schema=public"

# JWT
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo-y-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Origen(es) permitidos para CORS y base de los links de verificación de email.
# Acepta varios separados por coma, p.ej.:
#   FRONTEND_URL="https://casa-creadores-frontend.vercel.app,https://casacreadores.com"
# Debe coincidir EXACTAMENTE con el origen del frontend (la barra final se ignora).
FRONTEND_URL="http://localhost:5173"

# Email.
# IMPORTANTE: mientras SMTP_HOST y SMTP_USER estén vacíos, el backend NO exige
# verificación por email (la cuenta se activa al registrarse). En cuanto se
# configuren, el registro vuelve a requerir confirmación por correo.
EMAIL_FROM="Casa Creadores <no-reply@casacreadores.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Pagos USDC (Circle API) - opcional para MVP, pagos funcionan en modo mock sin esto
CIRCLE_API_KEY=""
CIRCLE_API_URL="https://api-sandbox.circle.com"

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:4000/api"

# Enlaces sociales (opcionales). Si se dejan vacíos, los iconos NO se muestran
# en el footer, en vez de enlazar a un perfil inexistente.
VITE_SOCIAL_X=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_INSTAGRAM=""

# Email de contacto público (opcional). Si está vacío, el sitio usa únicamente
# el formulario interno de /contacto, sin mostrar ningún mailto.
VITE_CONTACT_EMAIL=""
